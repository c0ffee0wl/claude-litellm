# Prisma toolchain switches for the NATIVE LiteLLM install — the single source
# for BOTH consumers: setup.sh's run_prisma wrapper (`set -a; . this`) and the
# litellm unit (EnvironmentFile=). Rendered by setup.sh Phase 4a (__HOME__) to
# ~/.config/litellm/prisma.env. What setup.sh warms MUST be what the service
# reads — a one-sided edit silently splits the caches (CLAUDE.md >
# Troubleshooting, "any `prisma` command hangs"); keeping them in one file is
# what enforces that. Hand-run recipe for the same reason:
#   set -a; . ~/.config/litellm/prisma.env; set +a
# Not used under --docker (the image bakes its own toolchain).
#
# Flat CLI/engine cache (prisma-client-py's default is a versioned tree).
PRISMA_BINARY_CACHE_DIR=__HOME__/.cache/prisma-python/binaries
PRISMA_HIDE_UPDATE_MESSAGE=1
PRISMA_SKIP_POSTINSTALL_GENERATE=1
# Never probe an ambient `node`: on these boxes `which node` is the Phase 3
# `~/.bun/bin/node -> bun` symlink, and bun >=1.4.0 answers prisma-client-py's
# `node --version` probe with a REPL that waits on a TTY forever (CLAUDE.md >
# Troubleshooting, "`~/.bun/bin/node --version` child"). The private nodeenv
# that setup.sh heals and warms is the only toolchain used.
PRISMA_USE_GLOBAL_NODE=false
# The Prisma CLI phones checkpoint.prisma.io on every invocation;
# PRISMA_HIDE_UPDATE_MESSAGE only hides the printout.
CHECKPOINT_DISABLE=1
# npm counts min-release-age in DAYS (a stale pnpm-style 10080 in ~/.npmrc
# reads as ~27 years and blocks the pinned 2024 prisma CLI; env overrides
# ~/.npmrc). Covers the in-service CLI (re)install path too.
npm_config_min_release_age=7
# Startup-migration budgets: read by litellm-proxy-extras >=0.4.84 (litellm
# >=1.97.0); ignored by the 0.4.81 that litellm <=1.96.2 pins. These ARE
# upstream's defaults — pinned so a future retune can't move this fleet; the
# bootstrap value is also setup.sh's per-step timeout for run_prisma.
LITELLM_PRISMA_BOOTSTRAP_TIMEOUT=600
LITELLM_PRISMA_COMMAND_TIMEOUT=60
