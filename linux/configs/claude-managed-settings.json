{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "allowManagedPermissionRulesOnly": false,
  "allowManagedHooksOnly": false,
  "allowManagedMcpServersOnly": false,
  "enableAllProjectMcpServers": false,
  "voiceEnabled": false,
  "channelsEnabled": false,
  "disableDeepLinkRegistration": "disable",
  "disableRemoteControl": true,
  "skipWebFetchPreflight": true,

  "autoUploadSessions": false,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "enableArtifact": false,
  "feedbackDrafts": "off",

  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },

  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_GROWTHBOOK": "1",
    "CLAUDE_CODE_DISABLE_FEATURE_FLAGS": "1",

    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_INSTALL_GITHUB_APP_COMMAND": "1",

    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0"
  },

  "permissions": {
    "disableAutoMode": "disable",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(rm -Rfv *)",
      "Bash(rm -vRf *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(mount *)",
      "Bash(chmod +s *)",
      "Bash(chmod 777 *)",
      "Bash(chown root *)",
      "Bash(* > /dev/tcp/*)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *| sh*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(dpkg *)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git reset --hard*)",

      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.netrc)",
      "Read(~/.config/litellm/config.yaml)",
      "Read(~/.config/litellm/env)",
      "Read(~/.local/state/claude-litellm/db-backups/**)",

      "Read(~/.openai/**)",
      "Read(~/.anthropic/**)",
      "Read(~/.config/codex/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/google/**)",
      "Read(~/.config/op/**)",
      "Read(~/.terraform.d/**)",

      "Read(__REPO_DIR__/.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(!**/.env.template)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(//root/**)",
      "Read(//etc/shadow)",
      "Read(//etc/passwd)",
      "Read(//etc/group)",

      "Read(~/.profile)",
      "Read(~/.zshenv)",
      "Read(~/.bashrc)",
      "Read(~/.zshrc)",
      "Read(~/.zprofile)",
      "Read(~/.bash_profile)",

      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.profile)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",

      "Edit(~/.ssh/**)",

      "Edit(~/.claude.json)",
      "Edit(~/.claude/*.json)",
      "Edit(~/.claude/*.md)",
      "Edit(~/.claude/*.sh)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/backups/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/dev-mods/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/local/**)",
      "Edit(~/.claude/output-styles/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/session-env/**)",
      "Edit(~/.claude/shell-snapshots/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/workflows/**)",
      "Edit(~/.config/litellm/**)",

      "Bash(curl *)",
      "Bash(* | curl *)",
      "Bash(wget *)",
      "Bash(* | wget *)",
      "Bash(nc *)",
      "Bash(* | nc *)",
      "Bash(ncat *)",
      "Bash(* | ncat *)",
      "Bash(node -e *)",

      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(bun install *)",
      "Bash(bun add *)",
      "Bash(systemctl *)",
      "Bash(journalctl *)",

      "Bash(env)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(set)",

      "NotebookEdit"
    ],
    "allow": []
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__REPO_DIR__/linux/hooks/pretooluse-bash-guard.sh\""
          }
        ]
      }
    ]
  }
}
