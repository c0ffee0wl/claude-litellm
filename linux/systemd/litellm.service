[Unit]
Description=LiteLLM — Anthropic-compatible gateway to Azure OpenAI / Vertex Gemini / etc.
# Headroom for slow first boots (Prisma schema sync + engine fetch, 15–25s) and
# for the boot race against Postgres. Raise BOTH numbers together: the limiter
# gives up at a cycle time below IntervalSec/Burst, so widening Burst alone
# would narrow that. See CLAUDE.md, "StartLimitBurst=20 on the litellm units".
StartLimitBurst=20
StartLimitIntervalSec=600

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
EnvironmentFile=__ENV_FILE__
Environment=PATH=__PATH__
Environment=LITELLM_MODE=PRODUCTION
# WARNING, not ERROR: failures that silently break a single surface are logged
# at warning by litellm — a lazy-loaded feature whose import failed (its
# endpoints then 404 until restart) and the startup schema-sync retries. INFO is
# too chatty in steady state. Note litellm_proxy_extras uses its own logger,
# fixed at INFO and independent of this variable.
Environment=LITELLM_LOG=WARNING
Environment=LITELLM_LOCAL_ANTHROPIC_BETA_HEADERS=true
# --- Outbound TLS/DNS tuning for the aiohttp transport ---------------------
# Keep these in sync with litellm-docker-compose.yml. Env vars, NOT
# `litellm_settings` — the cost-map fetch runs at module level during
# `import litellm`, before config.yaml is parsed, so a config-file pin would
# silently miss it. Measurements + the diagnostic runbook live in CLAUDE.md,
# "TLSV1_UNRECOGNIZED_NAME"; don't restate the figures here.
#
# NOTE: no SSL_ECDH_CURVE pin here, deliberately — one was carried and removed.
# Re-add `Environment=SSL_ECDH_CURVE=prime256v1` here AND in the compose file
# only if TLSV1_UNRECOGNIZED_NAME actually recurs; the reasons it went, and the
# measured curve results, are in the CLAUDE.md runbook named above.
#
# Never take an egress proxy from the ambient environment: a --user unit inherits
# the whole user-manager environment, so a desktop proxy setting would tunnel
# prompt content and the provider API key through it. Remove this line if a
# deployment genuinely needs a corporate proxy to reach its provider.
Environment=DISABLE_AIOHTTP_TRUST_ENV=True
# Pinned to litellm's own 300s default, explicitly, so an upstream retune can't
# move it under us — and deliberately NOT lowered to aiohttp's 10s. Why, with
# the measurements: CLAUDE.md, "AIOHTTP_TTL_DNS_CACHE is pinned to 300".
Environment=AIOHTTP_TTL_DNS_CACHE=300
# Prisma toolchain switches (cache dir, global-node opt-out, npm cooldown,
# checkpoint opt-out, startup-migration budgets) come from ONE file shared
# with setup.sh's run_prisma wrapper, so what Phase 4a warms is what this
# service reads — see linux/configs/litellm-prisma.env for each switch's
# rationale. `-`: tolerate its absence (a --docker box never renders it; that
# unit variant doesn't reference it). WorkingDirectory above also makes
# prisma-client-py read ./pyproject.toml (Node LTS pin for the nodeenv).
EnvironmentFile=-__APP_DIR__/prisma.env
# Wait (bounded) for the host Postgres socket before paying the start arc — a
# --user unit cannot After= the system postgresql@ instance, so litellm races
# it at boot, and without this gate every retry cycle costs a full proxy
# import + two Node spawns against a dead socket. `$$` is systemd's literal-$
# escape (renders to `$(seq 60)` in the spawned shell). ~120s ceiling, then
# falls through with exit 0 so an absent DB degrades to the old behavior and
# can never fail the unit. setup.sh Phase 7 substitutes __PGPORT__ on
# local-DB runs and DELETES this line for an external DATABASE_URL (a remote
# DB is not probeable by local pg_isready). TimeoutStartSec bounds
# ExecStartPre and must stay above the loop's ceiling.
TimeoutStartSec=180
ExecStartPre=/bin/sh -c 'for _ in $$(seq 60); do pg_isready -q -h /run/postgresql -p __PGPORT__ && exit 0; sleep 2; done; exit 0'
# Schema posture: the v2 migration resolver keeps `prisma migrate deploy` but
# skips the diff-and-force recovery that caused the migrate storm, and warns
# when the DB is ahead of this build instead of silently dropping columns the
# way `db push` does — see CLAUDE.md > Key Conventions, "DB schema posture".
# Selected TWICE, deliberately. The env var is what 1.108.0+ reads (v2 is its
# default; pinned so a future default flip cannot silently bring back the
# storm). The `--use_v2_migration_resolver` flag on ExecStart is what OLDER
# releases read — 1.97.0 ignores the env var and defaults to v1 — and a box
# can run an older litellm under this unit: Phase 4a keeps the existing
# version when its converge fails (uv cooldown, network). 1.108.0 accepts the
# flag and only prints a one-line deprecation notice. Keep the env var in
# sync with litellm-docker-compose.yml (whose image tag is always the pin, so
# it needs no flag).
Environment=USE_V2_MIGRATION_RESOLVER=true
# --num_workers 1 is deliberate despite upstream's single-VM advice: each worker
# runs its own Prisma query engine whose resident memory ratchets to a
# high-water mark, and this box is CPU- and RAM-constrained.
ExecStart=__LITELLM_BIN__ --config __APP_DIR__/config.yaml --port __PORT__ --host 127.0.0.1 --num_workers 1 --telemetry False --use_v2_migration_resolver
# `always`, not `on-failure` — see CLAUDE.md, "Restart policy for long-lived
# user services". A commanded stop is still never restarted.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
