[Unit]
Description=Claude DevTools - Web UI for Claude Code session inspection
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=__CLAUDE_DEVTOOLS_DIR__
ExecStart=__BUN_BIN__ run __CLAUDE_DEVTOOLS_DIR__/dist-standalone/index.cjs
# `always`, not `on-failure` — see CLAUDE.md. A bun HTTP server exits 0 when its
# event loop drains, and on-failure ignores a clean exit.
Restart=always
RestartSec=5
Environment=PATH=__PATH__
Environment=PORT=__CLAUDE_DEVTOOLS_PORT__
Environment=HOST=127.0.0.1
# %h = the user's home dir, expanded by systemd itself (same idiom as
# litellm.service's PRISMA_BINARY_CACHE_DIR) — no sed token needed.
Environment=CLAUDE_ROOT=%h/.claude

[Install]
WantedBy=default.target
